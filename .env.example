# ============================================
# Mikrotik Manager - Configurações
# ============================================

# Banco de Dados PostgreSQL (roda no Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mikrotik_manager
DB_USER=your_user_here
DB_PASS=your_password_here

# Mikrotik Router API
MIKROTIK_API_URL=http://YOUR_MIKROTIK_IP
MIKROTIK_API_PORT=80

# Mikrotik Credenciais (para autenticação na API REST)
MIKROTIK_USER=your_user_here
MIKROTIK_PASS=your_password_here
