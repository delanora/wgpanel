{
    "name": "delanora/wgpanel",
    "description": "WG Panel - Gerenciamento de VPNs WireGuard em Mikrotik",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml tests/Unit/",
        "test:integration": "phpunit --configuration phpunit.xml tests/Integration/",
        "test:setup": "php tests/setup_test_db.php"
    },
    "config": {
        "allow-plugins": {
            "phpunit/phpunit": true
        },
        "sort-packages": true
    }
}
